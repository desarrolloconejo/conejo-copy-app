# Copia este archivo a .env y rellena los valores. .env esta en .gitignore.

# --- Aplicacion -----------------------------------------------------------

# Clave con la que se firman las sesiones. Larga, aleatoria y exclusiva de este
# despliegue. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Dias que dura una sesion antes de caducar. Opcional, por defecto 30.
SESSION_TTL_DAYS=30

# Nombre visible de la aplicacion. Opcional.
VITE_APP_TITLE=Conejo Copy Check

# --- Docker ---------------------------------------------------------------

# Contrasena de root de MySQL dentro del contenedor. Obligatoria para compose.
MYSQL_ROOT_PASSWORD=

# Nombre de la base. Opcional, por defecto conejo_copy_check.
MYSQL_DATABASE=conejo_copy_check

# Puerto del host por el que se publica la aplicacion. Opcional, por defecto 3000.
# Mantenlo cerrado en el cortafuegos mientras no haya TLS delante.
APP_PORT=3000

# --- Solo fuera de Docker -------------------------------------------------

# Con compose, DATABASE_URL la define el propio docker-compose.yml apuntando al
# servicio "db". Define esta variable unicamente si ejecutas la app a mano.
# DATABASE_URL=mysql://usuario:contrasena@127.0.0.1:3306/conejo_copy_check
